{
  "manifest_version": 2,
  "name": "HTML PiP Helper",
  "version": "0.1.3",
  "description": "HTML5-Videos im Hintergrund weiterspielen: Player-Vollbild öffnen, dann Android-Home drücken. Ohne zusätzliche Buttons.",
  "browser_specific_settings": {
    "gecko": {
      "id": "html-pip-helper@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }]
}
