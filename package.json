{
  "name": "html-pip-helper",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "description": "Bild-in-Bild-Helfer für Firefox auf Android",
  "scripts": {
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest --filename html-pip-helper-0.1.3.xpi",
    "test": "playwright test",
    "test:android": "node scripts/android-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "selenium-webdriver": "4.51.0",
    "web-ext": "10.8.0"
  }
}
